#!/usr/bin/env bash
# Opens the detail panel to the right of a coordinator: its agent flow on top (factory panel agentes --pane), the task's
# screenshots under it (factory panel recursos) and the task's changes below (factory review: commits + files vs base + delta diff). task-start calls it; run it by hand
# for a coordinator started earlier.
# Usage: task-panel <coordinator_pane_id> <task_dir>
set -euo pipefail
. "$(dirname "$0")/lib/hub.sh"
coord=${1:?coordinator pane}; dir=${2:?task dir}
[ "${HERDR_ENV:-}" = 1 ] || command -v herdr >/dev/null || { echo "needs Herdr" >&2; exit 1; }
# workspace.json panels.task: the hub's own list instead of the default three (agentes · recursos · cambios),
# stacked with the same height; each gets `--pane <coordinator pane>` (a panel can ignore it). `cambios` is factory review.
names=(); while IFS= read -r p; do names+=("$p"); done < <(jq -r '.panels.task // [] | .[]' "$HUB/workspace.json")   # bash 3.2: no mapfile
if [ ${#names[@]} -gt 0 ]; then
  n=${#names[@]}
  pane=$(herdr pane split "$coord" --direction right --ratio 0.55 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id'); ids=("$pane")
  for ((i = 1; i < n; i++)); do
    pane=$(herdr pane split "$pane" --direction down --ratio "$(LC_ALL=C awk -v k=$((n - i + 1)) 'BEGIN { printf "%.4f", 1 / k }')" --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id'); ids+=("$pane")
  done
  for ((i = 0; i < n; i++)); do
    herdr pane rename "${ids[$i]}" "${names[$i]}" >/dev/null 2>&1 || true
    if [ "${names[$i]}" = cambios ]; then herdr pane run "${ids[$i]}" "$ENGINE/bin/review" >/dev/null
    else herdr pane run "${ids[$i]}" "$ENGINE/bin/panel ${names[$i]} --pane $coord" >/dev/null; fi
  done
  echo "panel: $(for ((i = 0; i < n; i++)); do printf '%s %s · ' "${names[$i]}" "${ids[$i]}"; done)"; exit 0
fi
right=$(herdr pane split "$coord" --direction right --ratio 0.55 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
below=$(herdr pane split "$right" --direction down --ratio 0.35 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
shots=$(herdr pane split "$right" --direction down --ratio 0.5 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
herdr pane rename "$right" "agentes" >/dev/null 2>&1 || true
herdr pane rename "$below" "cambios" >/dev/null 2>&1 || true
herdr pane rename "$shots" "recursos" >/dev/null 2>&1 || true
herdr pane run "$right" "$ENGINE/bin/panel agentes --pane $coord" >/dev/null
herdr pane run "$below" "$ENGINE/bin/review" >/dev/null
herdr pane run "$shots" "$ENGINE/bin/panel recursos" >/dev/null
echo "panel: agentes $right · recursos $shots · cambios $below"
