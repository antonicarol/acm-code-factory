#!/usr/bin/env bash
# Minimizes a pane to its title line, or restores it (alt+m on the focused pane). A minimized pane keeps
# running; its label gets " ▸" so it reads as folded. alt+0..5 restore the pane they jump to.
#   fold [pane_id]          toggle (default: the focused pane)
#   fold --open <pane_id>   restore it if it is minimized, else nothing
# Only panes stacked in a column fold (it is their height that shrinks); a pane alone in its column is left alone.
. "$(dirname "$0")/lib/hub.sh"; state="$HUB/.board/fold"; mkdir -p "$state"
MARK=' ▸'; ROWS=2   # border with the title + one line (the panel shows "▸ click to open" there)

open_only=""; [ "${1:-}" = --open ] && { open_only=1; shift; }
pane=${1:-}
if [ -z "$pane" ]; then
  ws=$(herdr workspace list | jq -r '.result.workspaces[] | select(.focused) | .workspace_id')
  pane=$(herdr pane list --workspace "$ws" | jq -r '.result.panes[] | select(.focused) | .pane_id' | head -1)
fi
[ -n "$pane" ] || exit 0
file="$state/${pane//:/_}"   # only remembers the height to go back to

# Herdr resizes like tmux: --direction moves the pane's border on that side (or the opposite one if there is
# none). So a pane with a pane below shrinks by moving that neighbour's top border up, and grows by moving its
# own bottom border down; the last pane of a column uses its top border instead.
neighbour(){ herdr pane neighbor --direction "$1" --pane "$pane" | jq -r '.result.neighbor.neighbor_pane_id // empty'; }
below=$(neighbour down); other=${below:-$(neighbour up)}
[ -n "$other" ] || exit 0   # alone in its column
layout=$(herdr pane layout --pane "$pane" | jq -c '.result.layout')
rect(){ jq -c --arg p "$1" '.panes[] | select(.pane_id == $p) | .rect' <<<"$layout"; }
r=$(rect "$pane"); o=$(rect "$other")
# The split between the two panes (the smallest one holding both): the resize amount is a share of its height.
R=$(jq --argjson a "$r" --argjson b "$o" '[.splits[] | select(.direction == "down"
    and .rect.y <= ([$a.y, $b.y] | min) and .rect.y + .rect.height >= ([$a.y + $a.height, $b.y + $b.height] | max)
    and .rect.x <= $a.x and .rect.x + .rect.width >= $a.x + $a.width)] | sort_by(.rect.height) | .[0].rect.height' <<<"$layout")
[ "$R" != null ] || exit 0
h=$(jq .height <<<"$r")
label=$(herdr pane list --workspace "${pane%%:*}" | jq -r --arg p "$pane" '.result.panes[] | select(.pane_id == $p) | .label // ""')
label=${label%"$MARK"}
# Minimized = as short as fold leaves it (Herdr keeps the first pane of a column a bit taller), whatever any file says.
folded=""; [ "$h" -le $((ROWS + 2)) ] && folded=1
[ -n "$open_only" ] && [ -z "$folded" ] && exit 0
resize(){ herdr pane resize --pane "$1" --direction "$2" --amount "$(LC_ALL=C awk -v d="$3" -v r="$R" 'BEGIN { printf "%.4f", d / r }')" >/dev/null; }
if [ -n "$below" ]; then shrink(){ resize "$below" up "$1"; }; grow(){ resize "$pane" down "$1"; }
else shrink(){ resize "$pane" down "$1"; }; grow(){ resize "$pane" up "$1"; }; fi

if [ -n "$folded" ]; then   # restore: back to the remembered height (or a fair share), plain label
  orig=$(head -1 "$file" 2>/dev/null); [ "${orig:-0}" -gt "$h" ] 2>/dev/null || orig=$(( R / 2 > 10 ? R / 2 : 10 ))
  grow $((orig - h))
  if [ -n "$label" ]; then herdr pane rename "$pane" "$label" >/dev/null; else herdr pane rename "$pane" --clear >/dev/null; fi
  rm -f "$file"
else                        # minimize: remember the height, shrink, mark the label
  echo "$h" > "$file"
  shrink $((h - ROWS))
  # Herdr rounds the split: measure and correct the last line or two.
  now=$(herdr pane layout --pane "$pane" | jq --arg p "$pane" '.result.layout.panes[] | select(.pane_id == $p) | .rect.height')
  [ "$now" -lt "$ROWS" ] && grow $((ROWS - now))
  herdr pane rename "$pane" "${label:-panel}$MARK" >/dev/null
fi
